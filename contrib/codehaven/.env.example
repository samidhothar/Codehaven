# Copy to .env and set your own values before running "docker compose up -d --build"

# Jenkins administrator, CodeHaven uses the same account to create and run deployment pipelines
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=

# Host ports, change them when the defaults are already in use
CODEHAVEN_HTTP_PORT=3000
CODEHAVEN_SSH_PORT=2222
JENKINS_HTTP_PORT=8080
TEST_VM_HTTP_PORT=8081

# Outgoing email (notifications, password resets). Example for SendGrid:
#   MAILER_ENABLED=true, MAILER_SMTP_ADDR=smtp.sendgrid.net, MAILER_SMTP_PORT=587,
#   MAILER_USER=apikey, MAILER_PASSWORD=<your SendGrid API key>, MAILER_FROM=CodeHaven <noreply@example.com>
MAILER_ENABLED=false
MAILER_SMTP_ADDR=
MAILER_SMTP_PORT=587
MAILER_USER=
MAILER_PASSWORD=
MAILER_FROM=

# Renovate dependency updates, see "Dependency updates with Renovate" in the README
RENOVATE_TOKEN=
RENOVATE_INTERVAL_SECONDS=3600
# optional read-only github.com token, used only to add release notes to update pull requests
RENOVATE_GITHUB_COM_TOKEN=

# Actions runner for workflows such as the security scan, see "Security scanning" in the README.
# Workflow jobs reach CodeHaven at its address, so it must not be localhost, for example:
#   CODEHAVEN_ROOT_URL=http://host.docker.internal:3000/
CODEHAVEN_ROOT_URL=
RUNNER_REGISTRATION_TOKEN=
